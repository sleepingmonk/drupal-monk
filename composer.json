{
    "name": "sleepingmonk/drupal-monk",
    "description": "Project template for Drupal projects with composer and helpers.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Calvin Tyndall",
            "role": "Master Craftsman"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/11"
        }
    ],
    "require": {
        "composer/installers": "^2.3.0",
        "cweagans/composer-patches": "^1.7.3",
        "drupal/config_ignore": "^3.3",
        "drupal/config_split": "^2.0.2",
        "drupal/core-composer-scaffold": "^11.3.0",
        "drupal/core-recipe-unpack": "^11",
        "drupal/core-recommended": "^11.3.0",
        "drupal/core-vendor-hardening": "^11.2",
        "drupal/diff": "^1.10",
        "drupal/environment_indicator": "^4.0.25",
        "drupal/gin": "^5.0.12",
        "drupal/metatag": "^2.2.0",
        "drupal/metatag_ai": "^2.0.5",
        "drupal/paragraphs": "^1.20",
        "drupal/pathauto": "^1.14",
        "drupal/redirect": "^1.12",
        "drupal/xmlsitemap": "^2.0.0",
        "drush/drush": "^13",
        "joachim-n/composer-manifest": "^1.0",
        "kanopi/shrubs": "^1.0.0"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^11.2",
        "drupal/devel": "^5.5.0",
        "drupal/stage_file_proxy": "^3.1.6",
        "mglaman/phpstan-drupal": "^2.0",
        "phpunit/phpunit": "^13.0.5",
        "palantirnet/drupal-rector": "^0.21.0",
        "vincentlanglet/twig-cs-fixer": "^3",
        "webflo/drupal-finder": "^1.3.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-vendor-hardening": true,
            "ergebnis/composer-normalize": true,
            "joachim-n/composer-manifest": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ]
    },
    "scripts": {
        "drupal-scaffold": "DrupalComposer\\DrupalScaffold\\Plugin::scaffold",
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ScriptHandler::postInstall",
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/ -type d -name .git | xargs rm -rf"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "DrupalProject\\composer\\ScriptHandler::postInstall",
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/ -type d -name .git | xargs rm -rf"
        ],
        "lint": "find web/modules/custom web/themes/custom -name '*.php' -exec php -l {} \\;",
        "code-sniff": "echo 'No code sniff step defined.'",
        "unit-test": "echo 'No unit test step defined.'",
        "artifact-sync": [
            "rsync -KPar --delete --force --files-from=scripts/artifact-sync.ini ./ data/artifact/"
        ]
    },
    "extra": {
        "installer-paths": {
            "web/core": ["type:drupal-core"],
            "web/libraries/{$name}": ["type:drupal-library"],
            "web/modules/contrib/{$name}": ["type:drupal-module"],
            "web/profiles/contrib/{$name}": ["type:drupal-profile"],
            "web/themes/contrib/{$name}": ["type:drupal-theme"],
            "drush/contrib/{$name}": ["type:drupal-drush"]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./web"
            }
        },
        "working-repo": "[working repo git remote origin url goes here]"
    }
}
